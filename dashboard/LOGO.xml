<svg viewBox="0 0 500 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Fundo -->
  <rect width="500" height="400" fill="#f8f9fa" rx="15" ry="15"/>
  
  <!-- Círculo central representando o "Finder" -->
  <circle cx="250" cy="200" r="150" fill="#e9ecef" stroke="#007bff" stroke-width="8"/>
  
  <!-- Lupa -->
  <g transform="translate(135, 85) scale(0.8)">
    <!-- Cabo da lupa -->
    <rect x="190" y="150" width="120" height="20" rx="10" ry="10" fill="#343a40" transform="rotate(45, 190, 150)"/>
    
    <!-- Círculo da lupa -->
    <circle cx="150" cy="150" r="80" fill="none" stroke="#343a40" stroke-width="16"/>
  </g>
  
  <!-- Prédios representando franquias -->
  <g transform="translate(180, 160)">
    <!-- Prédio 1 -->
    <rect x="0" y="0" width="30" height="60" fill="#28a745" rx="2" ry="2"/>
    <rect x="10" y="15" width="10" height="10" fill="#f8f9fa"/>
    <rect x="10" y="35" width="10" height="10" fill="#f8f9fa"/>
    
    <!-- Prédio 2 -->
    <rect x="40" y="-20" width="30" height="80" fill="#fd7e14" rx="2" ry="2"/>
    <rect x="50" y="0" width="10" height="10" fill="#f8f9fa"/>
    <rect x="50" y="20" width="10" height="10" fill="#f8f9fa"/>
    <rect x="50" y="40" width="10" height="10" fill="#f8f9fa"/>
    
    <!-- Prédio 3 -->
    <rect x="80" y="10" width="30" height="50" fill="#dc3545" rx="2" ry="2"/>
    <rect x="90" y="20" width="10" height="10" fill="#f8f9fa"/>
    <rect x="90" y="40" width="10" height="10" fill="#f8f9fa"/>
  </g>
  
  <!-- Texto do logo -->
  <text x="250" y="320" font-family="Arial, sans-serif" font-size="28" font-weight="bold" text-anchor="middle" fill="#343a40">Franquia Finder</text>
  <text x="250" y="350" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#6c757d">Encontre a Franquia Ideal para seu Investimento</text>
  
  <!-- Gráfico de crescimento -->
  <polyline points="130,260 150,240 170,250 190,230 210,220 230,200" fill="none" stroke="#28a745" stroke-width="3"/>
  <circle cx="130" cy="260" r="3" fill="#28a745"/>
  <circle cx="150" cy="240" r="3" fill="#28a745"/>
  <circle cx="170" cy="250" r="3" fill="#28a745"/>
  <circle cx="190" cy="230" r="3" fill="#28a745"/>
  <circle cx="210" cy="220" r="3" fill="#28a745"/>
  <circle cx="230" cy="200" r="3" fill="#28a745"/>
  
  <!-- Ícone de localização -->
  <g transform="translate(300, 235) scale(0.6)">
    <path d="M0,0 C-10,-25 -40,-40 -40,-75 C-40,-110 -22.5,-120 0,-120 C22.5,-120 40,-110 40,-75 C40,-40 10,-25 0,0 Z" fill="#007bff"/>
    <circle cx="0" cy="-90" r="15" fill="#f8f9fa"/>
  </g>
  
  <!-- Moedas simbolizando investimento -->
  <g transform="translate(310, 245)">
    <circle cx="0" cy="0" r="12" fill="#ffc107" stroke="#fd7e14" stroke-width="2"/>
    <circle cx="10" cy="-5" r="12" fill="#ffc107" stroke="#fd7e14" stroke-width="2"/>
    <circle cx="20" cy="0" r="12" fill="#ffc107" stroke="#fd7e14" stroke-width="2"/>
  </g>
</svg>
